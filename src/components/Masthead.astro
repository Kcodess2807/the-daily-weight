---
import ThemeToggle from './ThemeToggle.astro';
import { frontPage, href, longDate, plural, type Edition } from '../editions';
interface Props { edition: Edition }
const { edition } = Astro.props;
const home = `/edition/${edition.date}`;
const { sections } = frontPage(edition);
const mustRead = edition.stories.filter((s) => s.data.must_read);
---
<div class="utility">
  <p>{longDate(edition.date)} · <span data-count>{plural(edition.stories.length)}</span></p>
  <nav aria-label="Paper">
    <a href="/archive">Archive</a>
    <a href="/rss.xml">RSS</a>
    <ThemeToggle />
  </nav>
</div>

<header class="nameplate">
  <h1><a href="/">The Daily Weight</a></h1>
  <p>An AI Newspaper</p>
</header>

<nav class="sections" aria-label="Sections">
  <a href={home}>Front page</a>
  {sections.map((s) => <a href={`${home}#${s.key}`}>{s.label}</a>)}
</nav>

{mustRead.length > 0 && (
  <p class="strip">
    <strong>Must read</strong>
    {mustRead.map((s) => <a href={href(s)}>{s.data.title}</a>)}
  </p>
)}
